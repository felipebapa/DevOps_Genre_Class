# Configuración del servidor de MLflow para docker-compose.
# Copiar a `.env` (que está en .gitignore) y ajustar:
#
#   cp .env.example .env
#
# Solo hace falta si el servidor NO se usa únicamente desde localhost.

# ── Hosts autorizados ────────────────────────────────────────────────────────
# MLflow 3 responde 403 "Invalid Host header" a cualquier Host que no esté en
# esta lista (protección anti DNS rebinding). Hay que incluir TODAS las formas
# en que se accede al servidor:
#
#   mlflow:5000        desde los contenedores del pipeline (red `mlops`)
#   localhost:5000     desde el navegador de la máquina que lo hospeda
#   192.168.1.50:5000  desde el navegador o el train.py de otro integrante
#
# Sustituir la IP por la de la máquina que hospeda MLflow (la misma de Jenkins).
MLFLOW_ALLOWED_HOSTS=mlflow:5000,localhost:5000,127.0.0.1:5000,192.168.1.50:5000

# Atajo para una LAN de confianza (laboratorio, sustentación): acepta cualquier
# Host. Cómodo, pero no usar en un servidor expuesto a internet.
# MLFLOW_ALLOWED_HOSTS=*

# ── Puerto publicado en el host ──────────────────────────────────────────────
# Cambiar solo si el 5000 ya está ocupado. El puerto interno sigue siendo 5000,
# así que `http://mlflow:5000` no cambia para el pipeline.
MLFLOW_PORT=5000
